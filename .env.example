# ─── PHONE NOTIFICATIONS ─── (set at least one, Telegram is easiest)

# 1) TELEGRAM  — talk to @BotFather -> /newbot -> copy token
#    then message your bot once, and open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 2) NTFY — install the "ntfy" app (iOS/Android), subscribe to a secret topic name.
#    Loud alarm-style push. Pick something unguessable.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# 3) WEB PUSH (PWA on your phone home screen). Run: npm run keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com

# ─── FOREX (optional) ───
# Free key from https://twelvedata.com  (crypto works without any key)
TWELVEDATA_KEY=

PORT=8787
